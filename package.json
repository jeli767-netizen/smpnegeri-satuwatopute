{
  "name": "smpnegeri-satuwatopute",
  "productName": "SPMB SMP Negeri 1 Watopute",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Aplikasi penerimaan peserta didik baru terpadu UPTD SMP Negeri 1 Watopute untuk desktop Windows.",
  "author": {
    "name": "UPTD SMP Negeri 1 Watopute",
    "email": "smp1watopute@gmail.com"
  },
  "homepage": "https://smpnegeri1watopute.sch.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeli767-netizen/smpnegeri-satuwatopute.git"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist release build/icon.png build/icon.ico",
    "lint": "tsc --noEmit",
    "icons": "node scripts/prepare-icons.mjs",
    "electron": "electron .",
    "electron:dev": "npm run icons && npm run build && electron .",
    "dist": "npm run icons && npm run build && electron-builder --win portable --x64",
    "dist:installer": "npm run icons && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^31.7.4",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "id.netizen.smpnegeri.satuwatopute",
    "productName": "SPMB SMP Negeri 1 Watopute",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SPMB SMP Negeri 1 Watopute",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
